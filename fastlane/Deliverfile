# Portfolio Vault — App Store metadata (no binary upload).
# Edit files under fastlane/metadata/, then run: bundle exec fastlane metadata_upload

app_identifier("com.portfolio.app.ios")

skip_binary_upload(true)
skip_screenshots(true)
force(true)
run_precheck_before_submit(false)
precheck_include_in_app_purchases(false)

# Version that receives release_notes.txt (override with APP_VERSION=1.0.6).
app_version(ENV.fetch("APP_VERSION", "1.0.6"))
